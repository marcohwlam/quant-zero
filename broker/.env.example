# Alpaca Paper Trading Credentials
# Get these from: https://app.alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=your_paper_trading_api_key_here
ALPACA_API_SECRET=your_paper_trading_api_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional: override endpoints for specific environments
# ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
